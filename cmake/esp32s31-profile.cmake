# ESP32-S31 产品 SDK 预设，默认目标为 esp32，根对解析为 esp32 的组合要求 ESP-IDF。
# 最终平台由 CC_TARGET_PLATFORM 的 cache/显式输入解析，功能 FORCE 与平台选择分别处理。
# 根对本预设的功能开关强制写回 cache，限定 OpenAI-compatible、streaming、
# 文件/记忆工具、图像输入、分段会话及 JSON 记忆，产品在 main 注入硬件工具。
# 队列/工具池、异步观测、SQLite、Anthropic、重复 active-memory 摘要等沿下列 OFF。
# 预算值以字节计，JSON 记忆一 MiB、上下文内联媒体512 KiB，根验证非负整数。
# 本文件只有配置期变量赋值，无运行资源创建及自定义函数，最终裁剪以编译/链接输入核对。
set(CC_PROFILE_TARGET_PLATFORM esp32)

set(CC_PROFILE_ENABLE_FILE_TOOLS ON)
set(CC_PROFILE_ENABLE_HTTP_TOOL OFF)
set(CC_PROFILE_ENABLE_MEMORY ON)
set(CC_PROFILE_ENABLE_SHELL OFF)
set(CC_PROFILE_ENABLE_PLUGIN OFF)
set(CC_PROFILE_ENABLE_MULTI_AGENT OFF)
set(CC_PROFILE_ENABLE_RUN_QUEUE OFF)
set(CC_PROFILE_ENABLE_TOOL_POOL OFF)
set(CC_PROFILE_ENABLE_SKILLS OFF)
set(CC_PROFILE_ENABLE_SKILL_WATCHER OFF)
set(CC_PROFILE_ENABLE_PLUGIN_HOT_RELOAD OFF)
set(CC_PROFILE_ENABLE_PLUGIN_WORKERS OFF)
set(CC_PROFILE_ENABLE_MCP OFF)
set(CC_PROFILE_ENABLE_MCP_STDIO OFF)
set(CC_PROFILE_ENABLE_MCP_HTTP OFF)
set(CC_PROFILE_ENABLE_SUBAGENTS OFF)
set(CC_PROFILE_ENABLE_ACTIVE_MEMORY OFF)
set(CC_PROFILE_ENABLE_DOCKER_SANDBOX OFF)
set(CC_PROFILE_ENABLE_SQLITE OFF)
set(CC_PROFILE_ENABLE_OPENAI ON)
set(CC_PROFILE_ENABLE_OLLAMA OFF)
set(CC_PROFILE_ENABLE_ANTHROPIC OFF)
set(CC_PROFILE_ENABLE_MULTIMODAL ON)
set(CC_PROFILE_ENABLE_MEDIA_IMAGE ON)
set(CC_PROFILE_ENABLE_MEDIA_AUDIO OFF)
set(CC_PROFILE_ENABLE_MEDIA_VIDEO OFF)
set(CC_PROFILE_ENABLE_MEDIA_FILE OFF)
set(CC_PROFILE_ENABLE_MEDIA_OUTPUT OFF)
set(CC_PROFILE_ENABLE_INLINE_BASE64 ON)
set(CC_PROFILE_ENABLE_ARTIFACT_STORE OFF)
set(CC_PROFILE_ENABLE_STREAMING ON)
set(CC_PROFILE_ENABLE_ASYNC_OBSERVABILITY OFF)
set(CC_PROFILE_ENABLE_SESSION_STORE_MEMORY OFF)
set(CC_PROFILE_ENABLE_SESSION_STORE_JSON_FILE OFF)
set(CC_PROFILE_ENABLE_SESSION_STORE_JSON_SEGMENTED ON)
set(CC_PROFILE_ENABLE_MEMORY_STORE_JSON_FILE ON)
set(CC_PROFILE_JSON_MEMORY_MAX_FILE_BYTES 1048576)
set(CC_PROFILE_CONTEXT_MEDIA_MAX_BYTES 524288)
set(CC_PROFILE_ENABLE_SESSION_STORE_SQLITE OFF)

# 默认路径属于设备 VFS，BSP 挂载 USB 后由产品生命周期装配，路径声明不建立目录租约。
# 更换或重新插入 U 盘时由 main 完整重载当前盘配置、会话、账本与记忆。
set(CC_PROFILE_DEFAULT_CONFIG_PATH "")
set(CC_PROFILE_DEFAULT_DATA_DIR "/usb0/cclaw")
set(CC_PROFILE_DEFAULT_WORKSPACE_PATH "/usb0/workspace")
set(CC_PROFILE_DEFAULT_STORAGE_PATH "/usb0/cclaw/sessions")
set(CC_PROFILE_DEFAULT_MEMORY_PATH "/usb0/cclaw/memory.json")
set(CC_PROFILE_DEFAULT_SOUL_FILE "")
set(CC_PROFILE_DEFAULT_USER_FILE "")
