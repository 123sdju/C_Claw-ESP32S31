# CONFIG_IDF_TARGET="esp32s31"
# CONFIG_IDF_TARGET_ESP32S31=y

# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPIRAM=y

# Keep default logs readable while allowing runtime DEBUG selection.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL=4
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_SPIRAM_USE_MALLOC=y
# Keep only small mallocs internal; medium/large runtime buffers prefer PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Reserve 160KB internal RAM for DMA, FreeRTOS internals, and cache-disabled paths.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=163840
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM=y
# Put selected Wi-Fi/LwIP static data in PSRAM where ESP-IDF supports it.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Prefer PSRAM for Wi-Fi/LwIP heap allocations where possible.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_CAM_CTLR_DVP_CAM_ISR_CACHE_SAFE=y
# CONFIG_ESP_BOARD_ESP32_S31_KORVO1=y
# CONFIG_ESP_BOARD_NAME="esp32_s31_korvo1"

# LVGL display/font defaults for the on-device UI.
# Use esp_lvgl_adapter's PPA path instead of LVGL's native PPA backend.
# CONFIG_LV_USE_PPA is not set
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_DEFAULT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=0
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_STDIO_PATH=""
CONFIG_LV_FS_STDIO_CACHE_SIZE=0
# CONFIG_LV_USE_TINY_TTF is not set
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=64
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_DMA2D_OPERATION_FUNC_IN_IRAM=y
# CONFIG_DMA2D_ISR_IRAM_SAFE is not set
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=y
# Work around TLS certificate signature failures seen in PSA/on-chip ECDSA verify
# on the current ESP32S31 + ESP-IDF master combination.
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y


CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=6
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_STATIC_TX_BUFFER_NUM=8
CONFIG_WIFI_RMT_RX_BA_WIN=6
CONFIG_WIFI_RMT_TX_BA_WIN=6

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_TX_BA_WIN=6

CONFIG_LWIP_TCP_QUEUE_OOSEQ=n
# Long-run profiling keeps the local web API active while the firmware opens
# outbound TLS connections to the LLM provider. Leave enough lwIP sockets for
# both sides instead of relying on the IDF default.
CONFIG_LWIP_MAX_SOCKETS=16
# Enable task run-time counters so firmware profile snapshots can report CPU
# distribution per FreeRTOS task.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_RGB_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUB_I2C_SUPPORT=y

# Board Manager peripherals
CONFIG_ESP_BOARD_PERIPH_GPIO_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y



CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y


# Camera 如果你还要摄像头
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CAMERA_SUB_DVP_SUPPORT=y

CONFIG_ESP_BOARD_DEV_FS_FAT_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUB_SDMMC_SUPPORT=y

CONFIG_ESP_BOARD_DEV_LED_STRIP_SUPPORT=y
CONFIG_ESP_BOARD_DEV_POWER_CTRL_SUPPORT=y


CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Allow debug clients to honor model.tls.verify=false.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y





CONFIG_CAMERA_OV3660=y

#
# Auto detect OV3660
#
# default:
CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
# end of Auto detect OV3660

#
# Choose supported formats for DVP interface
#
# CONFIG_CAMERA_OV3660_DVP_JPEG_1280X720_12FPS is not set
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_640X480_10FPS=y
# default:
# CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_240X240_24FPS is not set
# CONFIG_CAMERA_OV3660_DVP_YUV422_YUYV_640X480_10FPS is not set
# end of Choose supported formats for DVP interface

# default:
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
# default:
# CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_640X480_10FPS is not set
# default:
CONFIG_CAMERA_OV3660_DVP_IF_FORMAT_INDEX_DEFAULT=0


CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
